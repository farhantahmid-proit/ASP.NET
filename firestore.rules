rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. GLOBAL SAFETY NET (Default-Deny Catch-All)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. HARDENED PRIMITIVE HELPERS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'github.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isScoreMetric(val) {
      return (val is int || val is float) && val >= 0 && val <= 100;
    }

    // =========================================================================
    // 3. ENTITY VALIDATION BLUEPRINTS (Anti-Update-Gap)
    // =========================================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'githubUsername',
          'photoURL',
          'providerId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'githubUsername',
          'photoURL',
          'providerId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.githubUsername is string && data.githubUsername.size() <= 100 &&
        data.photoURL is string && data.photoURL.size() <= 500 &&
        data.providerId is string && data.providerId.size() >= 1 && data.providerId.size() <= 40 &&
        (data.providerId == 'github.com' || data.providerId == 'google.com') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 254 &&
        data.updatedAt is timestamp;
    }

    function isValidCommitTitlesArray(arr) {
      return arr is list &&
        arr.size() <= 25 &&
        (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 240));
    }

    function isValidAuditHistoryRecord(data, auditId) {
      return data.keys().hasAll([
          'auditId',
          'ownerId',
          'repoFullName',
          'repoUrl',
          'runPhase',
          'mode',
          'totalCommitsCount',
          'selectedCommitsCount',
          'performanceBefore',
          'performanceAfter',
          'accessibilityBefore',
          'accessibilityAfter',
          'bestPracticesBefore',
          'bestPracticesAfter',
          'seoBefore',
          'seoAfter',
          'securityBefore',
          'securityAfter',
          'summaryNotes',
          'commitTitles',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'auditId',
          'ownerId',
          'repoFullName',
          'repoUrl',
          'runPhase',
          'mode',
          'totalCommitsCount',
          'selectedCommitsCount',
          'performanceBefore',
          'performanceAfter',
          'accessibilityBefore',
          'accessibilityAfter',
          'bestPracticesBefore',
          'bestPracticesAfter',
          'seoBefore',
          'seoAfter',
          'securityBefore',
          'securityAfter',
          'summaryNotes',
          'commitTitles',
          'createdAt',
          'updatedAt'
        ]) &&
        data.auditId is string && data.auditId.size() >= 1 && data.auditId.size() <= 128 &&
        data.auditId == auditId &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.ownerId == request.auth.uid &&
        data.repoFullName is string && data.repoFullName.size() >= 1 && data.repoFullName.size() <= 200 &&
        data.repoUrl is string && data.repoUrl.size() >= 1 && data.repoUrl.size() <= 500 &&
        data.runPhase is string && data.runPhase.size() >= 1 && data.runPhase.size() <= 16 &&
        (data.runPhase == 'static' || data.runPhase == 'lhr') &&
        data.mode is string && data.mode.size() >= 1 && data.mode.size() <= 16 &&
        (data.mode == 'live' || data.mode == 'demo') &&
        data.totalCommitsCount is int && data.totalCommitsCount >= 0 && data.totalCommitsCount <= 100 &&
        data.selectedCommitsCount is int && data.selectedCommitsCount >= 0 && data.selectedCommitsCount <= 100 &&
        isScoreMetric(data.performanceBefore) &&
        isScoreMetric(data.performanceAfter) &&
        isScoreMetric(data.accessibilityBefore) &&
        isScoreMetric(data.accessibilityAfter) &&
        isScoreMetric(data.bestPracticesBefore) &&
        isScoreMetric(data.bestPracticesAfter) &&
        isScoreMetric(data.seoBefore) &&
        isScoreMetric(data.seoAfter) &&
        isScoreMetric(data.securityBefore) &&
        isScoreMetric(data.securityAfter) &&
        data.summaryNotes is string && data.summaryNotes.size() >= 1 && data.summaryNotes.size() <= 1000 &&
        isValidCommitTitlesArray(data.commitTitles) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // 4. COLLECTION RULES: /users/{userId} & /users/{userId}/private/{docId}
    // =========================================================================
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
        isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isOwner(userId) &&
        isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'githubUsername',
          'photoURL',
          'providerId',
          'updatedAt'
        ]);

      allow delete: if false;

      match /private/{docId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if false;

        allow create: if isOwner(userId) &&
          isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isOwner(userId) &&
          isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']) &&
          exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if false;
      }

      match /audits/{auditId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(auditId) &&
          existing().ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow list: if isOwner(userId) &&
          resource.data.ownerId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(auditId) &&
          isValidAuditHistoryRecord(incoming(), auditId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if isOwner(userId) &&
          isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(auditId) &&
          isValidAuditHistoryRecord(incoming(), auditId) &&
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().auditId == existing().auditId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'selectedCommitsCount',
            'performanceAfter',
            'accessibilityAfter',
            'bestPracticesAfter',
            'seoAfter',
            'securityAfter',
            'summaryNotes',
            'commitTitles',
            'updatedAt'
          ]) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow delete: if isOwner(userId) &&
          isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(auditId) &&
          existing().ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }
    }

    // =========================================================================
    // 5. COLLECTION RULES: /audits/{auditId}
    // =========================================================================
    match /audits/{auditId} {
      allow get: if isSignedIn() &&
        isValidId(auditId) &&
        existing().ownerId == request.auth.uid;

      allow list: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() &&
        isVerifiedUser() &&
        isValidId(auditId) &&
        isValidAuditHistoryRecord(incoming(), auditId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isSignedIn() &&
        isVerifiedUser() &&
        isValidId(auditId) &&
        isValidAuditHistoryRecord(incoming(), auditId) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().auditId == existing().auditId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'selectedCommitsCount',
          'performanceAfter',
          'accessibilityAfter',
          'bestPracticesAfter',
          'seoAfter',
          'securityAfter',
          'summaryNotes',
          'commitTitles',
          'updatedAt'
        ]);

      allow delete: if isSignedIn() &&
        isVerifiedUser() &&
        isValidId(auditId) &&
        existing().ownerId == request.auth.uid;
    }
  }
}
