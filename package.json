{
  "name": "fresnel",
  "version": "2.0.0",
  "description": "Fresnel — Zero-AI Open-Source Web Quality, AST Codemod & All-in-One Site Audit Workbench",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:server": "tsx watch server.ts",
    "dev:client": "vite --port 4200",
    "start": "node server.ts",
    "build": "node scripts/build.mjs",
    "build:client": "vite build",
    "build:embed": "vite build --config vite.embed.config.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "jasmine --config=jasmine.engine.json && jasmine --config=tests/jasmine.json",
    "test:suite": "jasmine --config=tests/jasmine.json"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.132.0",
    "@typescript-eslint/parser": "^8.73.0",
    "acorn": "^8.19.0",
    "axe-core": "^4.14.1",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.3",
    "culori": "^4.0.2",
    "diff": "^9.0.0",
    "eslint": "^10.15.0",
    "fast-glob": "^3.3.3",
    "jscodeshift": "^17.4.0",
    "lighthouse": "^13.6.0",
    "magic-string": "^1.4.5",
    "parse5": "^8.1.1",
    "postcss": "^8.5.33",
    "postcss-scss": "^4.0.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "simple-git": "^4.1.0",
    "stylelint": "^18.1.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "web-vitals": "^6.2.3",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.132.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jasmine": "^7.0.0",
    "jasmine-core": "^7.0.2",
    "typescript": "~5.7.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
