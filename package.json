{
  "name": "fresnel",
  "version": "1.0.0",
  "description": "Fresnel — Zero-AI Open-Source Node.js & TypeScript Web Quality, AST Codemod & Lighthouse Audit Workbench",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "ng": "ng",
    "dev:server": "tsx watch server.ts",
    "dev:client": "ng serve --proxy-config proxy.conf.json",
    "build": "node scripts/build.mjs",
    "lint": "tsc --noEmit -p tsconfig.app.json",
    "test": "ng test --watch=false --browsers=ChromeHeadlessCI",
    "test:engine": "jasmine --config=jasmine.engine.json && jasmine --config=tests/jasmine.json",
    "test:suite": "jasmine --config=tests/jasmine.json",
    "test:typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.6.1",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.73.0",
    "acorn": "^8.19.0",
    "axe-core": "^4.14.1",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.3",
    "culori": "^4.0.2",
    "d3": "^7.9.2",
    "diff": "^9.0.0",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "fast-glob": "^3.3.3",
    "firebase": "^13.4.0",
    "jscodeshift": "^17.4.0",
    "lighthouse": "^13.6.0",
    "magic-string": "^1.4.5",
    "parse5": "^8.1.1",
    "postcss": "^8.5.33",
    "postcss-scss": "^4.0.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "rxjs": "~7.8.0",
    "simple-git": "^4.1.0",
    "stylelint": "^18.1.0",
    "ts-morph": "^28.0.0",
    "tslib": "^2.8.0",
    "tsx": "^4.21.0",
    "web-vitals": "^6.2.3",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "yaml": "^2.8.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@types/express": "^4.17.21",
    "@types/jasmine": "^7.0.0",
    "@types/node": "^22.0.0",
    "jasmine": "^7.0.0",
    "jasmine-core": "^7.0.2",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "typescript": "~5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
