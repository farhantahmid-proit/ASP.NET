# Server-side HMAC secret for signing Workspace JWTs (generate 32+ random bytes in production)
JWT_SECRET="replace-with-a-long-random-secret"
# Comma-separated allowlist of frontend origins allowed to call Fresnel APIs cross-origin
FRESNEL_CORS_ORIGINS=""
# Persistent data directory for auth-store.json (mount a Coolify volume here in production)
FRESNEL_AUTH_DATA_DIR="/data/fresnel"
# Runtime binary paths (pre-configured in Dockerfile)
CHROME_PATH="/usr/bin/chromium"
SITEONE_BIN_PATH="/usr/local/bin/siteone-crawler"
# Optional server-side Google PageSpeed Insights API key for higher Lighthouse quota
PAGESPEED_API_KEY=""
# Optional server-side Gemini API key for AI Executive Summary synthesis
GEMINI_API_KEY=""
# Optional custom API base URL for Vite frontend builds (leave blank for same-origin)
VITE_API_BASE_URL=""
VITE_FRESNEL_API_BASE_URL=""
